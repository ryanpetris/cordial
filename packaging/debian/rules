#!/usr/bin/make -f

%:
	dh $@ --buildsystem=none

# The archive supplies the release executable and Cargo notices.
override_dh_strip:
override_dh_dwz:

override_dh_compress:
	dh_compress -Xdocs -Xproto -Xnotices -Xdependencies.json -XDEPENDENCIES.md

execute_after_dh_fixperms:
	find debian/cordial -exec touch --no-dereference --date="@$$SOURCE_DATE_EPOCH" {} +

override_dh_gencontrol:
	dh_gencontrol -- -DHomepage="$${CORDIAL_HOMEPAGE:-https://github.com/ryanpetris/cordial}"

override_dh_builddeb:
	dh_builddeb -- -Zxz
