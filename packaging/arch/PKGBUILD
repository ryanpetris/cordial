pkgname=cordial
pkgver=${CORDIAL_VERSION:-0.0.0}
pkgrel=1
pkgdesc='Manager for Cordial Bluetooth adapters'
arch=(x86_64)
url=${CORDIAL_HOMEPAGE:-https://github.com/ryanpetris/cordial}
license=(MIT)
depends=('glibc>=2.43' 'glib2>=2.88' 'gtk4>=4.22' 'libadwaita>=1.9'
         libgcc pango librsvg systemd-libs systemd dconf adwaita-icon-theme hicolor-icon-theme)
options=(!strip !debug)
source=("cordial-$pkgver-linux-amd64.tar.gz")
sha256sums=("${CORDIAL_ARCHIVE_SHA256:?Supply the release archive checksum}")

package() {
  local root="$srcdir/cordial-$pkgver-linux-amd64"
  install -Dm755 "$root/cordial" "$pkgdir/usr/bin/cordial"
  install -Dm644 "$root/share/glib-2.0/schemas/dev.petris.cordial.gschema.xml" \
    "$pkgdir/usr/share/glib-2.0/schemas/dev.petris.cordial.gschema.xml"
  install -d "$pkgdir/usr/share/doc/cordial"
  cp -a "$root/docs" "$root/proto" "$root/notices" "$root/dependencies.json" \
    "$root/DEPENDENCIES.md" "$root/VERSION" "$pkgdir/usr/share/doc/cordial/"
  find "$pkgdir/usr/share/doc/cordial" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/doc/cordial" -type f -exec chmod 644 {} +
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/cordial/LICENSE"
  install -Dm644 "$root/50-cordial.rules" "$pkgdir/usr/lib/udev/rules.d/50-cordial.rules"
  install -Dm644 "$root/dev.petris.cordial.desktop" "$pkgdir/usr/share/applications/dev.petris.cordial.desktop"
  install -Dm644 "$root/dev.petris.cordial.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.petris.cordial.png"
  install -Dm644 "$root/dev.petris.cordial.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.petris.cordial.svg"
}
