{
  "name": "cordial-desktop",
  "productName": "Cordial",
  "version": "0.0.0",
  "description": "Desktop manager for Cordial Bluetooth adapters",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Ryan Petris <ryan@petris.net>",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "npm --workspace @cordial/protocol run generate",
    "check:generated": "npm --workspace @cordial/protocol run check:generated",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "vite build --config vite.main.config.mjs && vite build --config vite.preload.config.mjs && vite build --config vite.renderer.config.mjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "start": "npm run build && electron .",
    "simulate": "npm run build && CORDIAL_DESKTOP_SIMULATE=2 electron .",
    "serve": "node scripts/serve.mjs",
    "check": "npm run check:generated && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialport": "13.0.0",
    "usb": "3.1.0"
  },
  "devDependencies": {
    "@cordial/client": "0.0.0",
    "@cordial/protocol": "0.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "desktopName": "cordial-desktop.desktop",
  "allowScripts": {
    "@serialport/bindings-cpp": true,
    "electron-winstaller": true,
    "fsevents": true
  }
}
