{
  "name": "@cordial/protocol",
  "version": "0.0.0",
  "description": "Cordial serial API messages and framing",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check && node --test scripts/schema-build.test.mjs",
    "lint": "buf lint ../../../proto --config buf.yaml",
    "breaking": "python3 ../../../tools/check_protocol.py --base"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0"
  }
}
