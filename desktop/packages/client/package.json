{
  "name": "@cordial/client",
  "version": "0.0.0",
  "description": "Client for the Cordial serial API over a byte stream, Node serial ports or Web Serial",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./web": "./src/web.ts"
  },
  "dependencies": {
    "@cordial/protocol": "0.0.0",
    "@bufbuild/protobuf": "2.16.0"
  },
  "peerDependencies": {
    "serialport": "13.0.0"
  },
  "peerDependenciesMeta": {
    "serialport": {
      "optional": true
    }
  }
}
